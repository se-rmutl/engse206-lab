<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" version="24.7.17">
  <diagram name="crbs-w10-scope-ladder" id="crbs-w10-scope-ladder">
    <mxGraphModel page="1" pageWidth="1600" pageHeight="900" background="#FFFFFF">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="บันไดขอบเขตรุ่นแรก (Increment 1) ของ CRBS" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=TH Sarabun New;fontSize=46;fontColor=#173B65;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1000" height="50" as="geometry"/></mxCell>
        <mxCell id="t2" value="Build now / Overview / Later / ไม่ทำในวิชานี้ — จัดลำดับพัฒนา ไม่ใช่ลบออกจาก SRS" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=TH Sarabun New;fontSize=28;fontColor=#526579;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="72" width="1100" height="34" as="geometry"/></mxCell>
        <mxCell id="rule" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9ED;strokeColor=#D89715;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1075" y="40" width="470" height="72" as="geometry"/></mxCell>
        <mxCell id="rulet" value="&lt;b&gt;กติกาข้อเดียว&lt;/b&gt;&lt;br&gt;จัดลำดับพัฒนา ≠ ลบออกจาก SRS (ทุก FR ยังอยู่)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=TH Sarabun New;fontSize=24;fontColor=#172333;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1090" y="44" width="450" height="64" as="geometry"/></mxCell>
        <mxCell id="L10" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#008699;strokeColor=#008699;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="55" y="150" width="330" height="216" as="geometry"/></mxCell>
        <mxCell id="Lt10" value="&lt;b&gt;&lt;font style='font-size:36px'&gt;Build now&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:22px'&gt;Dev เริ่มเขียนได้หลัง W13 — ต้องมี กล่อง + state + หน้าจอ + action/sequence&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=TH Sarabun New;fontSize=22;fontColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="70" y="160" width="300" height="196" as="geometry"/></mxCell>
        <mxCell id="R10" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F7FA;strokeColor=#008699;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="405" y="150" width="1140" height="216" as="geometry"/></mxCell>
        <mxCell id="Rt10" value="• UC-01 ค้นหาทรัพยากรที่ว่าง (FR-01/02, BR-06)&lt;br&gt;• UC-02 สร้าง/แก้ Draft และ Submit (FR-03/04, BR-01–03, TD-04)&lt;br&gt;• UC-04 Officer ตรวจและตัดสิน standard request (FR-06, BR-04/06/07/08, NFR-04)&lt;br&gt;• UC-03 ดูสถานะ/ประวัติคำขอตนเอง (FR-05 ส่วนดู, FR-09)&lt;br&gt;• cross-cutting: audit ทุก state change + สิทธิ์ตาม role (NFR-02/03, TD-17)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=TH Sarabun New;fontSize=26;fontColor=#172333;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="425" y="158" width="1110" height="200" as="geometry"/></mxCell>
        <mxCell id="L11" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#173B65;strokeColor=#173B65;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="55" y="380" width="330" height="156" as="geometry"/></mxCell>
        <mxCell id="Lt11" value="&lt;b&gt;&lt;font style='font-size:36px'&gt;Overview&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:22px'&gt;อยู่ในภาพรวม/ข้อมูล/กติกา — ยังไม่มีหน้าจอ-contract ละเอียด (increment 2)&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=TH Sarabun New;fontSize=22;fontColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="70" y="390" width="300" height="136" as="geometry"/></mxCell>
        <mxCell id="R11" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F7FA;strokeColor=#173B65;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="405" y="380" width="1140" height="156" as="geometry"/></mxCell>
        <mxCell id="Rt11" value="• UC-07 Check Out / UC-08 Return (FR-12/13, BR-10, DR-10/11)&lt;br&gt;• UC-09 สร้าง AvailabilityBlock — UI แบบง่ายสุด/fixture (FR-11, DR-06)&lt;br&gt;• UC-10 ดู audit trail ตามสิทธิ์ (FR-15, NFR-02)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=TH Sarabun New;fontSize=26;fontColor=#172333;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="425" y="388" width="1110" height="140" as="geometry"/></mxCell>
        <mxCell id="L12" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D89715;strokeColor=#D89715;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="55" y="550" width="330" height="166" as="geometry"/></mxCell>
        <mxCell id="Lt12" value="&lt;b&gt;&lt;font style='font-size:36px'&gt;Later&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:22px'&gt;increment ถัดไป หรือรอคำตอบเจ้าของเรื่อง — ระบุใน scope table + open decisions&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=TH Sarabun New;fontSize=22;fontColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="70" y="560" width="300" height="146" as="geometry"/></mxCell>
        <mxCell id="R12" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9ED;strokeColor=#D89715;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="405" y="550" width="1140" height="166" as="geometry"/></mxCell>
        <mxCell id="Rt12" value="• UC-06 ยกเลิกคำขอ (FR-08, BR-09)&lt;br&gt;• Needs Information → ส่งข้อมูลเพิ่ม รอบสอง (FR-05, DR-08)&lt;br&gt;• UC-05 Exception Review โดย Area Manager (FR-07, BR-05) — ดู DD-03&lt;br&gt;• No-show event (FR-14) · จัดการ Resource เต็มรูป (FR-10)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=TH Sarabun New;fontSize=26;fontColor=#172333;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="425" y="558" width="1110" height="150" as="geometry"/></mxCell>
        <mxCell id="L13" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#526579;strokeColor=#526579;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="55" y="730" width="330" height="136" as="geometry"/></mxCell>
        <mxCell id="Lt13" value="&lt;b&gt;&lt;font style='font-size:36px'&gt;ไม่ทำในวิชานี้ / รอคำตอบ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:22px'&gt;นอก Core หรือยังไม่มี owner/policy&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=TH Sarabun New;fontSize=22;fontColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="70" y="740" width="300" height="116" as="geometry"/></mxCell>
        <mxCell id="R13" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#526579;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="405" y="730" width="1140" height="136" as="geometry"/></mxCell>
        <mxCell id="Rt13" value="• Schedule integration (EXT-02) · External notification (EXT-03)&lt;br&gt;• reporting dashboard · penalty · attachment/photo · multi-resource&lt;br&gt;• เชื่อม OI-04, OI-05, OI-06" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=TH Sarabun New;fontSize=26;fontColor=#172333;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="425" y="738" width="1110" height="120" as="geometry"/></mxCell>
        <mxCell id="cut" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F7FA;strokeColor=#008699;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="55" y="880" width="1490" height="80" as="geometry"/></mxCell>
        <mxCell id="cutt" value="&lt;b&gt;&lt;font color='#087E8B'&gt;ลำดับการตัดตาม Complexity Profile:&lt;/font&gt;&lt;/b&gt; integration → attachment/report → exception (UC-05) → admin (UC-09/10)&lt;br&gt;&lt;font color='#526579' style='font-size:23px'&gt;ห้ามตัด UC-02 (ส่งคำขอ), UC-04 (ตัดสิน), UC-07/08 (ส่งมอบ/รับคืน) พร้อมกัน — ระบบจะเหลือแค่ค้นหา&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=TH Sarabun New;fontSize=26;fontColor=#172333;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="75" y="886" width="1450" height="68" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
