        <mxCell id="w10t" value="&lt;b&gt;&lt;font style=&quot;font-size:32px&quot; color=&quot;#087E8B&quot;&gt;W10 Design Strategy&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#087E8B&quot;&gt;ตัดสินใจว่า &quot;จะลงมือยังไง&quot; — ผลิต 3 อย่าง&lt;/font&gt;&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=TH Sarabun New;fontSize=25;fontColor=#172333;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="742" y="166" width="790" height="70" as="geometry"/></mxCell>
