  <diagram name="crbs-w10-why-w10-bridge" id="crbs-w10-why-w10-bridge">
    <mxGraphModel page="1" pageWidth="1600" pageHeight="720" background="#FFFFFF">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="ทำไมมี SRS แล้วยังเขียนโค้ดไม่ได้ทันที" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=TH Sarabun New;fontSize=44;fontColor=#173B65;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="1000" height="50" as="geometry"/></mxCell>
        <mxCell id="t2" value="W10 คือสะพานจาก &quot;ระบบต้องทำอะไร&quot; (SRS) ไปสู่ &quot;Dev เริ่มลงมือยังไง&quot;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=TH Sarabun New;fontSize=27;fontColor=#526579;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="1100" height="34" as="geometry"/></mxCell>
        <mxCell id="srs" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F7FA;strokeColor=#173B65;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="55" y="150" width="470" height="470" as="geometry"/></mxCell>
        <mxCell id="srst" value="&lt;b&gt;&lt;font style=&quot;font-size:32px&quot;&gt;SRS (จบ W08)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;ตอบว่า &quot;ระบบต้องทำอะไร&quot;&lt;/i&gt;&lt;br&gt;• 15 FR · 10 BR · 8 NFR · 13 DR&lt;br&gt;• 12 US · 10 UC · 24 AC&lt;br&gt;• สถานะ: Baseline Candidate&lt;br&gt;• (ยังไม่อนุมัติ · OI-01–08 เปิดอยู่)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=TH Sarabun New;fontSize=25;fontColor=#172333;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="75" y="168" width="430" height="220" as="geometry"/></mxCell>
        <mxCell id="nq" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9ED;strokeColor=#D89715;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="73" y="398" width="434" height="196" as="geometry"/></mxCell>
        <mxCell id="nqt" value="&lt;b&gt;&lt;font color=&quot;#D89715&quot;&gt;แต่ SRS ไม่ได้บอกว่า&lt;/font&gt;&lt;/b&gt;&lt;br&gt;— เริ่มเขียนอันไหนก่อน (15 FR พร้อมกันไม่ได้)&lt;br&gt;— ตรงไหนพลาดแล้วพังทั้งใบ&lt;br&gt;— เรื่องที่ยังไม่รู้ (OI) ทำยังไงระหว่างรอ" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=TH Sarabun New;fontSize=24;fontColor=#172333;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="93" y="410" width="398" height="172" as="geometry"/></mxCell>
